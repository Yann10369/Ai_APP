DATABASE_URL=mysql+asyncmy://root:password@127.0.0.1:3306/ai_album
JWT_SECRET=change-me-in-production-please-use-long-random-string
JWT_EXPIRE_SECONDS=7200
# AI_SERVICE 可选值: mock | real
#   mock: 本地随机分类（开发/CI 用）
#   real: 调用 model.inference 中的阿里云多模态 API（需配置 ALIYUN_API_KEY）
AI_SERVICE=mock
DATA_DIR=./data
STATIC_URL_PREFIX=/static
MAX_UPLOAD_SIZE_MB=20
LOG_LEVEL=INFO

# —— 阿里云 DashScope（百炼）多模态视觉模型（AI_SERVICE=real 时生效）——
# API Key: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=
# 业务空间 ID（必填），从阿里云百炼控制台获取，形如 ws-xxxxxxxxxx
DASHSCOPE_WORKSPACE_ID=
# 地域，常见值：cn-beijing / cn-shanghai / cn-shenzhen / cn-hangzhou
DASHSCOPE_REGION=cn-beijing
# 可选：完整 base_url，若填了上面 workspace_id + region 就不用填这个
# DASHSCOPE_BASE_URL=
# 模型名（推荐 qwen3-vl-plus）
DASHSCOPE_MODEL=qwen3-vl-plus
DASHSCOPE_TIMEOUT=30
