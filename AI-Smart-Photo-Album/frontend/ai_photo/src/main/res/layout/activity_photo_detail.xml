<?xml version="1.0" encoding="utf-8"?>
<!--
    照片详情页 (Photo Detail) — 紧凑版
    设计目标：
      1) 顶部标题紧贴状态栏（仅保留状态栏距离，不再额外下移）
      2) 各区块 padding / margin 整体收紧 ~25%
      3) 主图 16:10 比例（更修长，比 3:2 更适合详情页视觉）
      4) AI 信息卡内部 padding 14dp，行间距 10dp

    结构：
      1. 顶部导航 (44dp, 标题 16sp)
      2. 主图 (16:10, 圆角 14dp, 右下角 1/18 角标)
      3. 缩略图胶卷条 (高 40dp, 圆形翻页 28dp)
      4. AI 信息卡 (4 行, 左列 72dp, 内部 padding 14dp)
      5. 相似照片 (高 52dp)
      6. 二级按钮 (高 38dp, 圆角 10dp)
      7. 操作栏 (48dp, 收藏 / 分享 / 删除)
      8. 底部导航 (50dp, 相册高亮)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    tools:context=".PhotoDetailActivity">

    <!-- 内容滚动区 -->
    <ScrollView
        android:id="@+id/detailScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/actionBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="14dp">

            <!-- ============================================================
                 2. 主照片展示区 (16:10 长方形, 圆角 14dp)
                 ============================================================ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mainImageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/mainImage"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/detail_bg_main_image"
                    android:scaleType="centerCrop"
                    android:contentDescription="主照片"
                    app:layout_constraintDimensionRatio="16:10"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- 序号角标：右下角, 60% 黑胶囊 -->
                <TextView
                    android:id="@+id/imageIndexBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/detail_bg_image_index_badge"
                    android:gravity="center"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="—/—"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="@id/mainImage"
                    app:layout_constraintEnd_toEndOf="@id/mainImage"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="10dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ============================================================
                 3. 底部缩略图胶卷条 (高 40dp, 翻页按钮 28dp)
                 ============================================================ -->
            <FrameLayout
                android:id="@+id/filmstripBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp">

                <HorizontalScrollView
                    android:id="@+id/thumbnailList"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:id="@+id/thumbnailContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <ImageView
                    android:id="@+id/filmstripLeft"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/detail_bg_thumb_arrow"
                    android:padding="7dp"
                    android:src="@drawable/detail_ic_chevron_left"
                    android:contentDescription="向左翻" />

                <ImageView
                    android:id="@+id/filmstripRight"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/detail_bg_thumb_arrow"
                    android:padding="7dp"
                    android:src="@drawable/detail_ic_chevron_right"
                    android:contentDescription="向右翻" />
            </FrameLayout>

            <!-- ============================================================
                 4. AI 智能信息卡片 (紧凑: 内 padding 14dp, 行间距 10dp)
                 ============================================================ -->
            <LinearLayout
                android:id="@+id/aiCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/detail_bg_ai_card"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- 第 1 行：AI 标签 -->
                <LinearLayout
                    android:id="@+id/aiRowTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_ai_tags_title"
                            android:textColor="#1B1F2A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginStart="3dp"
                            android:src="@drawable/app_ic_star_four"
                            android:contentDescription="AI" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/aiTagsContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- 分割线 1 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="#EEEEEE" />

                <!-- 第 2 行：AI 描述 -->
                <LinearLayout
                    android:id="@+id/aiRowDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_ai_desc_title"
                            android:textColor="#1B1F2A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginStart="3dp"
                            android:src="@drawable/app_ic_star_four"
                            android:contentDescription="AI" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/aiDescText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingMultiplier="1.4"
                        android:text="加载中…"
                        android:textColor="#666666"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 分割线 2 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="#EEEEEE" />

                <!-- 第 3 行：场景识别 -->
                <LinearLayout
                    android:id="@+id/aiRowScene"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_scene_title"
                            android:textColor="#1B1F2A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginStart="3dp"
                            android:src="@drawable/app_ic_star_four"
                            android:contentDescription="AI" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/detail_bg_scene_circle">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/detail_ic_sea_sun"
                                android:contentDescription="场景" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/sceneText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:text="—"
                            android:textColor="#1B1F2A"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 分割线 3 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="#EEEEEE" />

                <!-- 第 4 行：人物情绪 -->
                <LinearLayout
                    android:id="@+id/aiRowEmotion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="0dp">

                    <LinearLayout
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_emotion_title"
                            android:textColor="#1B1F2A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginStart="3dp"
                            android:src="@drawable/app_ic_star_four"
                            android:contentDescription="AI" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/detail_ic_emoji_smile"
                            android:contentDescription="情绪" />

                        <TextView
                            android:id="@+id/emotionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:text="—"
                            android:textColor="#1B1F2A"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============================================================
                 5. 二级操作按钮 (紧凑: 高度 38dp, 圆角 10dp)
                 ============================================================ -->
            <LinearLayout
                android:id="@+id/secondaryActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnReanalyze"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/detail_bg_outline_button"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/detail_ic_refresh"
                        android:contentDescription="重新分析" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="@string/detail_redo"
                        android:textColor="#4A90E2"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnEditTag"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/detail_bg_outline_button"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/detail_ic_tag"
                        android:contentDescription="修改标签" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="@string/detail_edit_tag"
                        android:textColor="#4A90E2"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ============================================================
         1. 顶部导航栏 (44dp, 紧贴状态栏)
         - 内容 paddingTop 由 detailScroll 主动上移避开状态栏
         - 标题 16sp 居中, 图标 20dp
         ============================================================ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/detail_ic_arrow_left"
            android:contentDescription="返回" />

        <TextView
            android:id="@+id/topTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/detail_title"
            android:textColor="#1B1F2A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/headerMoreBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="7dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/public_bg_header_action"
            android:src="@drawable/public_ic_more"
            android:contentDescription="更多" />
    </LinearLayout>

    <!-- ============================================================
         7. 照片操作栏 (48dp, 三等分)
         ============================================================ -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@drawable/detail_bg_action_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:id="@+id/actionFavorite"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/app_ic_star_five"
                android:contentDescription="收藏" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/detail_action_fav"
                android:textColor="#666666"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/app_ic_share"
                android:contentDescription="分享" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/detail_action_share"
                android:textColor="#666666"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionDelete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/app_ic_delete"
                android:contentDescription="删除" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/detail_action_delete"
                android:textColor="#666666"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================================
         8. 底部导航栏 (50dp, 相册激活)
         ============================================================ -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:weightSum="4"
        android:elevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/app_ic_home"
                app:tint="#999999"
                android:contentDescription="首页" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_home"
                android:textColor="#999999"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAlbum"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/app_ic_album"
                app:tint="#4A90E2"
                android:contentDescription="相册" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_album"
                android:textColor="#4A90E2"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAI"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/app_ic_ai"
                app:tint="#999999"
                android:contentDescription="AI 发现" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_ai"
                android:textColor="#999999"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/app_ic_user"
                app:tint="#999999"
                android:contentDescription="我的" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_me"
                android:textColor="#999999"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>