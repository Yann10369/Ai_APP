<?xml version="1.0" encoding="utf-8"?>
<!-- AI 任务历史项 (独立卡片, 圆角 12dp) 紧凑版 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/ai_bg_card_white_12"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="6dp">

    <!-- 左侧：大号状态图标 (圆形背景) -->
    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp">

        <View
            android:id="@+id/historyIconBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ai_bg_node_active" />

        <ImageView
            android:id="@+id/historyIcon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:src="@drawable/ai_ic_cloud_upload_big"
            android:contentDescription="任务" />
    </FrameLayout>

    <!-- 中间：标题 + 数据 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <!-- 标题行：今天 18:20 · 36 张 -->
        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今天 18:20 · 36 张"
            android:textColor="#1B1F2A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 数据行：成功 33 + 失败 3 + 状态 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="成功 "
                android:textColor="#7B8597"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/historySuccess"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="33"
                android:textColor="#1FBA82"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="失败 "
                android:textColor="#7B8597"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/historyFailed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#E02020"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/historyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="进行中"
                android:textColor="#4A90E2"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右侧：辅助文案 + 按钮 (纵向) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/historySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未完成"
            android:textColor="#FF8A33"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/historyActionBtn"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="5dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/ai_bg_outline_pill"
            android:drawableEnd="@drawable/ai_ic_chevron_right"
            android:drawablePadding="0dp"
            android:text="@string/ai_history_btn_continue"
            android:textColor="#4A90E2"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
