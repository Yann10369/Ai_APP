<?xml version="1.0" encoding="utf-8"?>
<!--
  "设置" 页面 (Pixel-perfect, Compact)
  ============================================
  全局规范：
   - 页面背景：settings_background (浅蓝径向 + 极浅灰底)
   - 屏幕左右 padding：12dp
   - 一级大卡片：纯白 14dp 圆角 + 极轻弥散投影
   - 二级子卡片：纯白 10dp 圆角 + 1dp 浅灰描边 (#EEEEEE)，无阴影
  整体尺寸 / 间距 较初版全面收窄 ~20%。

  五大模块：
   1. Header (标题 + 副标题 + 设置 squircle)
   2. 分类集合管理卡 (3 个 A/B/C 子卡，子卡内是 flexbox chip 流)
   3. 展示规则卡 (分段控制 + 2 开关)
   4. 操作按钮 (取消 / 保存)
   5. 底部导航 (4 Tab, "我的" 高亮)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_background"
    tools:context=".SettingsActivity">

    <!-- ============== 滚动区 ============== -->
    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="24dp"
            android:paddingBottom="12dp">

            <!-- ============== 1. 顶部标题与操作栏 ============== -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 左侧：标题 + 副标题 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_title"
                            android:textColor="#1B1F2A"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ai_ic_sparkle_multi"
                            android:contentDescription="@string/settings_cd_sparkle" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_subtitle"
                        android:textColor="#7B8597"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 右侧：设置 squircle 按钮 -->
                <ImageView
                    android:id="@+id/headerGearBtn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="7dp"
                    android:background="@drawable/settings_bg_squircle_btn"
                    android:src="@drawable/settings_ic_gear"
                    android:contentDescription="@string/settings_gear_cd" />
            </LinearLayout>

            <!-- ============== 2. 第一大模块：分类集合管理卡 ============== -->
            <LinearLayout
                android:id="@+id/categoryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/public_bg_card_white"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- 卡片头部 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/settings_bg_icon_circle_blue">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/settings_ic_cube_stack"
                            android:contentDescription="@string/settings_cd_cube" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_category_title"
                            android:textColor="#1B1F2A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/settings_category_subtitle"
                            android:textColor="#7B8597"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ====== 子卡 A：场景分类 ====== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:background="@drawable/settings_bg_sub_card_outline"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp">

                    <!-- 子卡头 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- 左侧：字母 + 名称 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="@drawable/settings_bg_letter_circle">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:includeFontPadding="false"
                                    android:text="@string/settings_letter_a"
                                    android:textColor="#4A90E2"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/settings_scene_card_title"
                                android:textColor="#1B1F2A"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 右侧操作 -->
                        <LinearLayout
                            android:id="@+id/btnAddScene"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:src="@drawable/settings_ic_plus_blue"
                                android:contentDescription="@string/settings_cd_plus" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/settings_add_category"
                                android:textColor="#4A90E2"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/settings_bg_divider_v" />

                        <LinearLayout
                            android:id="@+id/btnResetScene"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:src="@drawable/settings_ic_refresh"
                                android:contentDescription="@string/settings_cd_reset" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/settings_reset_default"
                                android:textColor="#555555"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Flexbox Chip 流 (运行时动态填充 / 当前为静态预览) -->
                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/flexScene"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:flexWrap="wrap"
                        app:alignItems="flex_start">

                        <include layout="@layout/settings_chip" />
                        <include layout="@layout/settings_chip" />
                        <include layout="@layout/settings_chip" />
                        <include layout="@layout/settings_chip" />
                        <include layout="@layout/settings_chip" />
                    </com.google.android.flexbox.FlexboxLayout>
                </LinearLayout>

                <!-- ====== 子卡 B：情绪分类 ====== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:background="@drawable/settings_bg_sub_card_outline"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="@drawable/settings_bg_letter_circle">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:includeFontPadding="false"
                                    android:text="@string/settings_letter_b"
                                    android:textColor="#4A90E2"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/settings_emotion_card_title"
                                android:textColor="#1B1F2A"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnAddEmotion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:src="@drawable/settings_ic_plus_blue"
                                android:contentDescription="@string/settings_cd_plus" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/settings_add_category"
                                android:textColor="#4A90E2"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/settings_bg_divider_v" />

                        <LinearLayout
                            android:id="@+id/btnResetEmotion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:src="@drawable/settings_ic_refresh"
                                android:contentDescription="@string/settings_cd_reset" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/settings_reset_default"
                                android:textColor="#555555"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/flexEmotion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:flexWrap="wrap"
                        app:alignItems="flex_start">

                        <include layout="@layout/settings_chip" />
                        <include layout="@layout/settings_chip" />
                        <include layout="@layout/settings_chip" />
                        <include layout="@layout/settings_chip" />
                        <include layout="@layout/settings_chip" />
                    </com.google.android.flexbox.FlexboxLayout>
                </LinearLayout>

                <!-- ====== 子卡 C：标签分类 ====== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:background="@drawable/settings_bg_sub_card_outline"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="@drawable/settings_bg_letter_circle">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:includeFontPadding="false"
                                    android:text="@string/settings_letter_c"
                                    android:textColor="#4A90E2"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/settings_tag_card_title"
                                android:textColor="#1B1F2A"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnAddTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:src="@drawable/settings_ic_plus_blue"
                                android:contentDescription="@string/settings_cd_plus" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/settings_add_tag"
                                android:textColor="#4A90E2"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/settings_bg_divider_v" />

                        <LinearLayout
                            android:id="@+id/btnResetTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:src="@drawable/settings_ic_refresh"
                                android:contentDescription="@string/settings_cd_reset" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/settings_reset_default"
                                android:textColor="#555555"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/flexTag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:flexWrap="wrap"
                        app:alignItems="flex_start">

                        <include layout="@layout/settings_chip" />
                        <include layout="@layout/settings_chip" />
                        <include layout="@layout/settings_chip" />
                        <include layout="@layout/settings_chip" />
                        <include layout="@layout/settings_chip" />
                    </com.google.android.flexbox.FlexboxLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============== 3. 第二大模块：展示规则卡 ============== -->
            <LinearLayout
                android:id="@+id/rulesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/public_bg_card_white"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="6dp">

                <!-- 卡片头 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/settings_bg_icon_circle_blue">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/settings_ic_sliders"
                            android:contentDescription="@string/settings_cd_sliders" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/settings_rules_title"
                        android:textColor="#1B1F2A"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 1：分段控制器 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_rules_count_label"
                        android:textColor="#3A4250"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/segmentGroup"
                        android:layout_width="148dp"
                        android:layout_height="26dp"
                        android:background="@drawable/settings_bg_segment_track"
                        android:padding="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/segmentShow5"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/settings_bg_segment_thumb_blue"
                            android:gravity="center"
                            android:text="@string/settings_rules_show_5"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/segmentShowAll"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/settings_rules_show_all"
                            android:textColor="#7B8597"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2：允许用户手动调整标签 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_rules_user_edit"
                        android:textColor="#3A4250"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:id="@+id/switchUserEdit"
                        android:layout_width="36dp"
                        android:layout_height="20dp"
                        android:background="@drawable/settings_bg_switch_track_on"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/settings_bg_switch_thumb" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============== 4. 底部操作按钮 ============== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/public_bg_outline_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/settings_btn_cancel"
                    android:textColor="#4A90E2"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/settings_bg_gradient_blue_purple_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/settings_btn_save"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ============== 5. 底部导航栏 (48dp, "我的" 高亮) ============== -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:weightSum="4"
        android:elevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/app_ic_home"
                app:tint="#999999"
                android:contentDescription="@string/nav_home" />

            <TextView
                android:layout_width="wrap_content"
