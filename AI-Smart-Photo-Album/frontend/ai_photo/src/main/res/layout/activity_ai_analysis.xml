<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 分析页面 (Pixel-perfect) 紧凑版
  ============================================
  全局规范：
   - 页面背景：ai_background (浅蓝径向 + 极浅灰底)
   - 屏幕左右 padding：16dp
   - 卡片：纯白 16dp 圆角 + 极轻弥散投影
   - 整体尺寸在原基础上压缩约 20-25%

  七大模块：
   1. 顶部标题栏 (AI分析 + 副标题 + 扫描/更多按钮)
   2. 图片导入入口卡 (含文件夹插画)
   3. 批量上传任务卡 (4 数据 + 进度 + 失败重传)
   4. AI 分析进度卡 (5 节点时间线 + 单体任务列表)
   5. 最近分析结果预览卡 (主图 + 标签 + 3 操作)
   6. 任务历史列表 (独立 item 卡)
   7. 底部导航 (4 Tab, "AI 分析" 高亮)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aiRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/album_background"
    tools:context=".AIAnalysisActivity">

    <!-- ============== 滚动区 ============== -->
    <ScrollView
        android:id="@+id/aiScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="10dp">

            <!-- ============== 1. 顶部标题与操作栏 ============== -->
            <LinearLayout
                android:id="@+id/aiHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 左侧：标题 (AI蓝 + 分析黑) + 副标题 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- 渐变色 AI Logo -->
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/brand_ai_logo"
                            android:contentDescription="AI Logo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_title_black"
                            android:textColor="#1B1F2A"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="5dp"
                            android:src="@drawable/ai_ic_sparkle_multi"
                            android:contentDescription="AI" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ai_subtitle"
                        android:textColor="#7B8597"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 右侧：搜索 / 更多 圆形按钮（与 album 统一） -->
                <ImageView
                    android:id="@+id/headerSearchBtn"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="6dp"
                    android:background="@drawable/public_bg_header_action"
                    android:src="@drawable/public_ic_search"
                    android:contentDescription="搜索" />

                <ImageView
                    android:id="@+id/headerMoreBtn"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:padding="6dp"
                    android:background="@drawable/public_bg_header_action"
                    android:src="@drawable/public_ic_more"
                    android:contentDescription="更多" />
            </LinearLayout>

            <!-- ============== 2. 图片导入入口卡 ============== -->
            <LinearLayout
                android:id="@+id/uploadEntryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:background="@drawable/public_bg_card_white"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <!-- 左侧内容区 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_upload_title"
                        android:textColor="#1B1F2A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- 状态行：已选择 36 张照片 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_upload_selected_prefix"
                            android:textColor="#7B8597"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:text="@string/ai_upload_count"
                            android:textColor="#4A90E2"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:layout_marginBottom="1dp"
                            android:text="@string/ai_upload_count_suffix"
                            android:textColor="#7B8597"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 标签行 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="7dp"
                            android:paddingEnd="7dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/ai_bg_chip_blue">

                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:src="@drawable/ai_ic_album"
                                android:contentDescription="相册" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:text="@string/ai_upload_tag_album"
                                android:textColor="#4A90E2"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="7dp"
                            android:paddingEnd="7dp"
                            android:background="@drawable/ai_bg_chip_green">

                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:src="@drawable/ai_ic_shield_check"
                                android:contentDescription="授权" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:text="@string/ai_upload_tag_auth"
                                android:textColor="#1FBA82"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 提示文案 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/ai_upload_hint"
                        android:textColor="#B5BCC8"
                        android:textSize="10sp" />

                    <!-- 按钮行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/btnReselect"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/public_bg_outline_btn"
                            android:text="@string/ai_upload_btn_reselect"
                            android:textColor="#4A90E2"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnStartUpload"
                            android:layout_width="0dp"
                            android:layout_height="26dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/ai_bg_blue_gradient_btn"
                            android:text="@string/ai_upload_btn_start"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 右侧文件夹插画 (3D 立体 PNG) -->
                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="center_vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="导入插画"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ai_import_folder_3d" />
                </FrameLayout>
            </LinearLayout>

            <!-- ============== 3. 批量上传任务卡 ============== -->
            <LinearLayout
                android:id="@+id/batchUploadCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:background="@drawable/public_bg_card_white"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <!-- 顶部：标题 + 状态胶囊 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ai_batch_title"
                        android:textColor="#1B1F2A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="7dp"
                        android:paddingEnd="8dp"
                        android:background="@drawable/ai_bg_status_blue">

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ai_ic_cloud_upload"
                            android:contentDescription="上传中" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:text="@string/ai_batch_status"
                            android:textColor="#4A90E2"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 核心数据行：4 等分 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_batch_total_label"
                            android:textColor="#7B8597"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="0"
                            android:tag="metricTotal"
                            android:textColor="#4A90E2"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_batch_uploaded_label"
                            android:textColor="#7B8597"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="0"
                            android:tag="metricUploaded"
                            android:textColor="#1B1F2A"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_batch_success_label"
                            android:textColor="#7B8597"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="0"
                            android:tag="metricSuccess"
                            android:textColor="#1FBA82"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_batch_failed_label"
                            android:textColor="#7B8597"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="0"
                            android:tag="metricFailed"
                            android:textColor="#E02020"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 进度条 + 78% -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ProgressBar
                        android:id="@+id/batchProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="14dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/ai_bg_progress" />

                    <TextView
                        android:id="@+id/batchProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="0%"
                        android:textColor="#1B1F2A"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 失败提示区 -->
                <LinearLayout
                    android:id="@+id/batchFailedHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/ai_bg_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="40dp"
                            android:layout_height="26dp"
                            android:background="@drawable/ai_bg_thumb_placeholder" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ai_batch_failed_msg"
                                android:textColor="#1B1F2A"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="@string/ai_batch_failed_reason"
                                android:textColor="#7B8597"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnBatchRetry"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/ai_bg_outline_pill"
                            android:text="@string/ai_batch_retry"
                            android:textColor="#4A90E2"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============== 4. AI 分析进度卡 ============== -->
            <LinearLayout
                android:id="@+id/aiProgressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:background="@drawable/public_bg_card_white"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <!-- 顶部：标题 + 68% -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ai_progress_title"
                        android:textColor="#1B1F2A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/aiProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#4A90E2"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 6dp 进度条 -->
                <ProgressBar
                    android:id="@+id/aiProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="7dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/ai_bg_progress_6dp" />

                <!-- 5 节点时间线 -->

                <!-- 分割线 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/ai_bg_divider" />

                <!-- 单体任务列表 -->
            </LinearLayout>

            <!-- ============== 5. 最近分析结果预览卡 ============== -->
            <LinearLayout
                android:id="@+id/recentPreviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:background="@drawable/public_bg_card_white"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_preview_title"
                    android:textColor="#1B1F2A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- 主体：主图(左) + 右侧(文本上 + 3按钮下，与照片底部对齐) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- 主图（最近一次分析完成的照片缩略图） -->
                    <ImageView
                        android:id="@+id/previewThumb"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/ai_bg_thumb_placeholder_sea"
                        android:contentDescription="@string/ai_preview_title" />

                    <!-- 右侧：文本 + 3按钮 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical"
                        android:gravity="bottom">

                        <!-- 右侧文本 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- 第 1 行：场景 + 情绪 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ai_preview_scene_label"
                                    android:textColor="#7B8597"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/previewScene"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ai_preview_scene"
                                    android:textColor="#1B1F2A"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="10dp"
                                    android:layout_marginStart="8dp"
                                    android:layout_marginEnd="8dp"
                                    android:layout_gravity="center_vertical"
                                    android:background="#E5E8EE" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ai_preview_mood_label"
                                    android:textColor="#7B8597"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/previewMood"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ai_preview_mood"
                                    android:textColor="#1FBA82"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- 第 2 行：标签（容器，运行时填充前 3 个 + "+(N-3)"） -->
                            <LinearLayout
                                android:id="@+id/previewTagRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ai_preview_tag_label"
                                    android:textColor="#7B8597"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- 第 3 行：AI 描述（运行时绑定真实 description，无数据时显示占位提示） -->
                            <TextView
                                android:id="@+id/previewDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:lineSpacingExtra="2dp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:text="还没有分析结果，上传一张照片试试"
                                android:textColor="#4A5160"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- 2 等分按钮：与照片底部对齐（已删除"确定保存"） -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="26dp"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <TextView
                                android:id="@+id/btnViewFull"
                                android:layout_width="0dp"
                                android:layout_height="26dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/ai_bg_outline_pill"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:text="@string/ai_preview_view"
                                android:textColor="#4A90E2"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/btnRedo"
                                android:layout_width="0dp"
                                android:layout_height="26dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/ai_bg_blue_gradient_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:text="@string/ai_preview_redo"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============== 6. 任务历史列表 ============== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/ai_history_title"
                android:textColor="#1B1F2A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

    <!-- ============== 7. 底部导航栏 (46dp) ============== -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:weightSum="4"
        android:elevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/app_ic_home"
                android:contentDescription="@string/nav_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_home"
                android:textColor="#999999"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAlbum"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/app_ic_album"
                android:contentDescription="@string/nav_album" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_album"
                android:textColor="#999999"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAI"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/app_ic_ai"
                android:contentDescription="@string/nav_ai" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_ai"
                android:textColor="#4A90E2"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/app_ic_user"
                android:contentDescription="@string/nav_me" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_me"
                android:textColor="#999999"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
