<?xml version="1.0" encoding="utf-8"?>
<!--
  可编辑标签胶囊 (Edit Chip) - Compact
  —
  1:1 规范 (Compact)：
   - 纯白底 + 0.5dp 浅灰描边，全圆角 (28dp 高度 = 胶囊)
   - 内部 4 元素横向居中：emoji + 文字 + 铅笔 + 垃圾桶
   - 元素间距 4dp；chip 之间 3dp (通过 layout_margin 控)
  FlexboxLayout 子项由 layout_marginStart/End/Top/Bottom 设置间距。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="28dp"
    android:layout_marginStart="3dp"
    android:layout_marginEnd="3dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/settings_bg_chip_outline"
    android:paddingStart="8dp"
    android:paddingEnd="4dp">

    <!-- 前置 Emoji（占位：运行时由 renderInto() 写入真实值） -->
    <TextView
        android:id="@+id/chipEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="·"
        android:textSize="12sp" />

    <!-- 标签文本（占位：运行时由 renderInto() 写入真实值） -->
    <TextView
        android:id="@+id/chipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:includeFontPadding="false"
        android:text="--"
        android:textColor="#1B1F2A"
        android:textSize="12sp" />

    <!-- 编辑图标 (铅笔) -->
    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:padding="3dp"
        android:src="@drawable/settings_ic_pencil"
        android:contentDescription="@string/settings_cd_edit"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" />

    <!-- 删除图标 (垃圾桶) -->
    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="1dp"
        android:padding="3dp"
        android:src="@drawable/settings_ic_trash"
        android:contentDescription="@string/settings_cd_delete"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" />
</LinearLayout>
