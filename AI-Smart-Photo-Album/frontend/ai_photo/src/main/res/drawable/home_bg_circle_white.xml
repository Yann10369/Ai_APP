<?xml version="1.0" encoding="utf-8"?>
<!-- 分类悬浮小圆：白底带白边（用两层 shape 模拟） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:right="2dp"
        android:left="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
