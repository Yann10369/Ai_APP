<?xml version="1.0" encoding="utf-8"?>
<!--
  头像 64dp 圆：白底带极淡描边 + 蓝色径向渐变模拟默认头像。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 描边 -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#EFF1F5" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- 内层蓝色渐变作为占位头像底色 -->
    <item
        android:bottom="2dp"
        android:top="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#6FA8FF"
                android:endColor="#9013FE" />
        </shape>
    </item>
</layer-list>
