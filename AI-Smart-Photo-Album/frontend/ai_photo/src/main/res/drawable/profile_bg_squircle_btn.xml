<?xml version="1.0" encoding="utf-8"?>
<!--
  顶部右侧设置按钮：白底 squircle (大圆角) + 轻投影。
  32dp 容器，半径 12dp 形成"圆角方形/多边形"视觉。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 投影层 -->
    <item android:bottom="0dp" android:right="0dp" android:left="0dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A1B1F2A" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- 主体 -->
    <item android:bottom="1dp" android:right="0dp" android:left="0dp" android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
