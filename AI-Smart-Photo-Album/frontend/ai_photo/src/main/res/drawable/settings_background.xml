<?xml version="1.0" encoding="utf-8"?>
<!--
  "设置"页面背景：
  顶层浅蓝色径向渐变 + 底层极浅灰 (#F8F9FA)。
  与 profile_background 保持一致。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底层：极浅灰 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8F9FA" />
        </shape>
    </item>

    <!-- 顶层：中心略偏上的浅蓝径向晕染 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="640dp"
                android:centerX="0.5"
                android:centerY="0.18"
                android:startColor="#E6EEFF"
                android:endColor="#00F8F9FA" />
        </shape>
    </item>
</layer-list>
