<?xml version="1.0" encoding="utf-8"?>
<!--
  顶部右侧设置 squircle 按钮：白底 12dp 大圆角 + 极轻投影。
  与 profile_bg_squircle_btn 保持一致。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="0dp" android:right="0dp" android:left="0dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A1B1F2A" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:right="0dp" android:left="0dp" android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
