<?xml version="1.0" encoding="utf-8"?>
<!-- Segmented Tabs 选中态：白底胶囊 + 轻投影 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="0dp" android:right="0dp" android:left="0dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A1B1F2A" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:right="0dp" android:left="0dp" android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
